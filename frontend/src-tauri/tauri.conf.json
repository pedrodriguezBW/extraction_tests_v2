{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Climatic Report Generator",
  "version": "0.5.0",
  "identifier": "com.climaticreportgenerator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Climatic Report Generator",
        "width": 1240,
        "height": 840,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8000 http://localhost:8000; img-src 'self' blob: asset: http://asset.localhost http://127.0.0.1:8000 http://localhost:8000; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
